# @author lxy
# Copy this file to .env. Never commit .env or real credentials.
# Required secrets are intentionally blank; generate unique values before startup.
DEV_COPILOT_MYSQL_ROOT_PASSWORD=
DEV_COPILOT_DB_PASSWORD=

# Local workspace exposed read-only to the Agent container.
DEV_COPILOT_ALLOWED_ROOT=

# Database identity. The application account must not be root.
DEV_COPILOT_DB_USERNAME=dev_copilot

# OpenAI-compatible model provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_L2=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# Engine runtime tuning. Compose forwards only this explicit allow-list.
REDIS_MAX_CONNECTIONS=20
DYNAMIC_CONFIG_KEY=dev_copilot:config
CONFIG_REFRESH_INTERVAL=30
APP_NAME=dev-copilot-engine
LOG_LEVEL=INFO

# Durable Agent state. Keep these paths inside the writable engine-metadata volume.
CHECKPOINT_DB_PATH=/data/dev-copilot/checkpoints.sqlite3
PROPOSAL_DB_PATH=/data/dev-copilot/proposals.sqlite3
RAG_DB_PATH=/data/dev-copilot/rag.sqlite3
