# @author lxy
# ===== LLM 配置（OpenAI 兼容协议：DeepSeek / 通义千问 等）=====
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# L2 复杂任务模型（留空则复用 LLM_MODEL）
LLM_MODEL_L2=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# ===== 运行时配置 =====
# Agent 可操作的工作区根目录（文件类工具会限制在此目录内）
WORKSPACE_DIR=./workspace
# 动态配置在 Redis 中的 Hash key
DYNAMIC_CONFIG_KEY=dev_copilot:config
# 动态配置热更新轮询间隔（秒）
CONFIG_REFRESH_INTERVAL=30

# ===== 服务配置 =====
APP_NAME=dev-copilot-engine
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
